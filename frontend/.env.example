# ─────────────────────────────────────────────
# LENS & LORE — Environment Variables
# Copy this file to .env.local for local dev.
# Set these in Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────

# App URL (no trailing slash)
# Local:      http://localhost:3001
# Production: https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Sanity CMS (optional — app works with mock data without these)
# Get from: https://sanity.io/manage → your project → API
NEXT_PUBLIC_SANITY_PROJECT_ID=demo1234
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-04-01

# Supabase (not currently used — auth is local mock)
# Uncomment if you add real auth later.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe (not currently used — payment is mock)
# Uncomment if you wire up real payments later.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
